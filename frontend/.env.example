# Copy to frontend/.env.local. Never commit a real .env file.

# Where the Node.js API runs. Used for server-side fetches and the /api rewrite.
BACKEND_URL=http://127.0.0.1:4000

# Admin sign-in at /admin (stop-gap until the backend has real sessions). All three are required.
ADMIN_EMAIL=admin@vendelia.fi
# Generate with: npm run admin:hash -w frontend -- "a password of at least 12 characters"
ADMIN_PASSWORD_HASH=
# Random string of 32+ characters used to sign the admin cookie
ADMIN_SESSION_SECRET=
