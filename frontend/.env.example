# Copy to frontend/.env.local. Never commit a real .env file.

# Vercel-only deployment: set DATABASE_URL to your Supabase pooler URI.
# This is server-only; never prefix it with NEXT_PUBLIC_.
# DATABASE_URL=YOUR_SUPABASE_POOLER_CONNECTION_STRING

# Leave unset/empty to run the existing API inside Next.js (recommended for Vercel).
# Only set this when using a separately deployed Fastify API.
BACKEND_URL=

# Authentication is configured in backend/.env locally, or Vercel server variables.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Supabase Auth verifies passwords; profiles supplies roles; auth_sessions stores token hashes.
# Retired: ADMIN_EMAIL, ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET are no longer used.
