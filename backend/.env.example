# Copy to backend/.env and adjust. Never commit a real .env.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Postgres connection string. Leave empty to use the embedded PGlite database in .data/pglite.
# With Docker: DATABASE_URL=postgres://vendelia:vendelia@localhost:5432/vendelia  (see infra/docker-compose.yml)
DATABASE_URL=
PGLITE_DIR=.data/pglite

FRONTEND_URL=http://localhost:3000
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE=/uploads

# At least 16 characters. Must be a long random value in production.
SESSION_SECRET=dev-only-insecure-session-secret
SESSION_DAYS=30

# mock = simulated payments for development. stripe = not implemented yet.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

EMAIL_FROM=Vendelia <noreply@vendelia.fi>
JOBS_ENABLED=true

# Demo data (development only). Seeded accounts: admin@vendelia.test, yritys@vendelia.test, asiakas@vendelia.test
SEED_ON_START=true
DEMO_PASSWORD=vendelia-demo

PRH_API_BASE=https://avoindata.prh.fi/opendata-ytj-api/v3
