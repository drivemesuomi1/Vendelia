# Copy to backend/.env. Never commit a real .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
API_HOST=127.0.0.1
PORT=4000
FRONTEND_URL=http://localhost:3000

# Platform policy, until a settings table is introduced.
COMMISSION_BPS=1500
COMMISSION_VAT_BPS=2550
VOUCHER_VALIDITY_MONTHS=3
REFUND_WINDOW_DAYS=14

# --- Checkout, vouchers and email (see docs/voucher-flow.md) ---
# TEMPORARY test checkout: skip payment and issue vouchers marked test/unpaid.
# Set to false (or delete) once a payment provider is integrated.
PAYMENT_BYPASS=false
# Optional guard while the bypass is on: only these emails or @domains may place test orders.
PAYMENT_BYPASS_ALLOWED_EMAILS=
# Public site address used in QR codes and email links.
PUBLIC_SITE_URL=https://www.vendelia.fi
# Outgoing email (any SMTP service, e.g. Resend, Brevo, Mailgun, Google Workspace).
# Without SMTP_HOST in development, emails and PDFs are saved to backend/.data/outbox instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Vendelia <info@vendelia.fi>
MAIL_REPLY_TO=info@vendelia.fi
# Local Postgres without TLS (development only); Supabase always uses TLS.
# DATABASE_SSL=disable
