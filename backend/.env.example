# Copy to backend/.env. Never commit a real .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
API_HOST=127.0.0.1
PORT=4000
FRONTEND_URL=http://localhost:3000

# Platform policy, until a settings table is introduced.
COMMISSION_BPS=1500
COMMISSION_VAT_BPS=2550
VOUCHER_VALIDITY_MONTHS=3
REFUND_WINDOW_DAYS=14
