# Copy to .env.docker for local Docker Compose; never commit the real file.
# In Dokploy, enter these as runtime application environment variables instead.
# Use the SAME Supabase project and settings as the current Vercel deployment.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
SUPABASE_STORAGE_BUCKET="Vendelia Main"

# Set BOTH to the actual HTTPS domain serving this deployment (staging or production).
PUBLIC_SITE_URL=https://www.vendelia.fi
FRONTEND_URL=https://www.vendelia.fi
# Leave empty: the Fastify API runs inside Next.js. No separate backend container.
BACKEND_URL=

COMMISSION_BPS=1500
COMMISSION_VAT_BPS=2550
VOUCHER_VALIDITY_MONTHS=3
REFUND_WINDOW_DAYS=14
# Preserve your current testing configuration deliberately when copying from Vercel.
PAYMENT_BYPASS=false
PAYMENT_BYPASS_ALLOWED_EMAILS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Vendelia <info@vendelia.fi>"
MAIL_REPLY_TO=info@vendelia.fi
